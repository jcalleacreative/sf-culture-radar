# backend/.env.example
# Copy this file to .env and fill in your values.

# Path to the SQLite database file (relative to where you run the scripts)
DATABASE_PATH=sf_radar.db

# Reddit API credentials — create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=sf-sketch-radar/1.0 by u/your_username

# How many posts to fetch per subreddit per run
REDDIT_POST_LIMIT=25

# YouTube Data API v3 key — optional.
# Create a project at https://console.cloud.google.com and enable the YouTube Data API v3.
# Without this key, the YouTube collector is skipped gracefully.
YOUTUBE_API_KEY=

# LLM provider to use for headline analysis: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI API key — required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Anthropic API key — required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Which model to use per provider (defaults shown below)
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_ANTHROPIC=claude-haiku-4-5-20251001

# Optional API key for the FastAPI server.
# If not set, the server runs in open mode (no auth required).
# Set this before exposing the server to the internet.
API_KEY=
